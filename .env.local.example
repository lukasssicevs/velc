# Resend API key, used by the contact form's API route (app/api/contact/route.ts)
# Get one at https://resend.com — free tier is enough for a contact form.
RESEND_API_KEY=

# Optional. Sender address for outgoing contact-form emails. Must be on a
# domain verified in Resend. If unset, falls back to Resend's shared
# onboarding@resend.dev sender, which works without domain verification.
# CONTACT_FROM_EMAIL="VELC Agency <hello@yourdomain.com>"
